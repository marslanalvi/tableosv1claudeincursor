{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "cc-api",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["pnpm@9.15.0", "--filter", "@tabula/server", "dev"],
      "port": 3200,
      "url": "http://localhost:3200",
      "env": {
        "PORT": "3200",
        "REALTIME_PORT": "3202",
        "DATABASE_URL": "postgres://tabula:tabula@localhost:5432/tabula_cc",
        "REDIS_URL": "redis://localhost:6379/1",
        "APP_URL": "http://localhost:5283",
        "API_URL": "http://localhost:3200"
      }
    },
    {
      "name": "cc-realtime",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["pnpm@9.15.0", "--filter", "@tabula/server", "dev:realtime"],
      "port": 3202,
      "url": "http://localhost:3202",
      "env": {
        "PORT": "3200",
        "REALTIME_PORT": "3202",
        "DATABASE_URL": "postgres://tabula:tabula@localhost:5432/tabula_cc",
        "REDIS_URL": "redis://localhost:6379/1",
        "APP_URL": "http://localhost:5283",
        "API_URL": "http://localhost:3200"
      }
    },
    {
      "name": "cc-web",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["pnpm@9.15.0", "--filter", "@tabula/web", "dev"],
      "port": 5283,
      "url": "http://localhost:5283",
      "env": {
        "TABULA_WEB_PORT": "5283",
        "TABULA_API_PROXY": "http://localhost:3200",
        "TABULA_REALTIME_PROXY": "ws://localhost:3202",
        "VITE_PUBLIC_APP_URL": "http://localhost:5284"
      }
    },
    {
      "name": "cc-public",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["pnpm@9.15.0", "--filter", "@tabula/public", "dev"],
      "port": 5284,
      "url": "http://localhost:5284",
      "env": {
        "TABULA_PUBLIC_PORT": "5284",
        "TABULA_API_PROXY": "http://localhost:3200"
      }
    }
  ]
}
